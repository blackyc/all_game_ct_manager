<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"[★0] 构建校验（勾一次即可）"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local base = getAddress("GameAssembly.dll")
if base == nil then
  showMessage("没找到 GameAssembly.dll。\n请先 Open Process 附加到 FrontierTale.exe。")
  error("no module")
end
local anchors = {
  { rva = 0xA3BF20, sig = "40 55 53 57 48 8D 6C 24", name = "CharacterCtrl.TakeDamage" },
  { rva = 0x77F2F0, sig = "48 89 5C 24 10",           name = "MapGatherTriggerHandler.OnHit" },
}
local bad = {}
for _, a in ipairs(anchors) do
  local want = {}
  for w in a.sig:gmatch("%x%x") do want[#want + 1] = tonumber(w, 16) end
  local got = readBytes(base + a.rva, #want, true)
  local okSig = (got ~= nil) and (#got == #want)
  if okSig then
    for i = 1, #want do if got[i] ~= want[i] then okSig = false break end end
  end
  if not okSig then
    local s = {}
    if got then for i = 1, #got do s[i] = string.format("%02X", got[i]) end end
    bad[#bad + 1] = string.format("%s\n  期望 %s\n  实际 %s", a.name, a.sig, table.concat(s, " "))
  end
end
if #bad &gt; 0 then
  showMessage("游戏构建不匹配，本表是按 Build.26751033 做的。\n\n" .. table.concat(bad, "\n\n") ..
    "\n\n换版本要重新取偏移：GameTrainer/frontiertale/DEV.md §8。")
  error("build mismatch")
end
print(string.format("[FrontierTale] build OK  base=%X", base))
{$asm}
[DISABLE]</AssemblerScript>
    </CheatEntry>
