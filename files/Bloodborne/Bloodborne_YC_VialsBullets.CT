    </CheatEntry>
    <CheatEntry>
      <ID>23</ID>
      <Description>"[30] 锁血（保持满血）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local cur=getAddressSafe('bb_hp')
local mx=getAddressSafe('bb_hpmax')
if cur==nil or mx==nil then print('[BB] HP not found - run [0] START first') return end
if _G.BB_HP then _G.BB_HP() end
local pid=getOpenedProcessID() local fails=0
local t=createTimer(nil,false) t.Interval=120
t.OnTimer=function(x)
 if getOpenedProcessID()~=pid then pcall(function() x.destroy() end) return end
 local ok,c=pcall(readInteger,cur) local ok2,m=pcall(readInteger,mx)
 if not ok or not ok2 or c==nil or m==nil then fails=fails+1 if fails&gt;5 then pcall(function() x.destroy() end) end return end
 if c&lt;m then pcall(writeInteger,cur,m) end
end
t.Enabled=true
_G.BB_HP=function() pcall(function() t.destroy() end) t=nil _G.BB_HP=nil end
print('[BB] keep HP full ON')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.BB_HP then _G.BB_HP() end
print('[BB] keep HP full OFF')
{$asm}
</AssemblerScript>
    </CheatEntry>
