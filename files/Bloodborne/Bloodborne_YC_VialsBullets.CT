end
local function ensureSyms()
  if getAddressSafe('bb_obj') then return true end
  local ok,base=pcall(readPointer,0x80553B0E0)
  if not ok or not base or base&lt;0x1000000000 or base&gt;=0x2000000000 then return false end
  registerSymbol('bb_obj',base,true)
  local ok1,v=pcall(readInteger,base+0x8B8) if ok1 and v then registerSymbol('bb_bullets',base+0x8B8,true) end
  local ok2,v2=pcall(readInteger,base+0x8E8) if ok2 and v2 then registerSymbol('bb_vials',base+0x8E8,true) end
  local ok3,v3=pcall(readInteger,base+0x1D4) if ok3 and v3 then registerSymbol('bb_echoes',base+0x1D4,true) end
  local ok4,c=pcall(readInteger,base+0x154) local ok5,m=pcall(readInteger,base+0x158)
  local ok6,hc=pcall(readInteger,0x1001AD56008) local ok7,hm=pcall(readInteger,0x1001AD5600C)
  if ok4 and ok5 and ok6 and ok7 and c==hc and m==hm and m and m&gt;0 then
    registerSymbol('bb_hp',0x1001AD56008,true) registerSymbol('bb_hpmax',0x1001AD5600C,true)
  else
    local hcand,hm2,hlist=locateHP(base)
    if hcand then registerSymbol('bb_hp',hcand,true) registerSymbol('bb_hpmax',hcand+4,true)
      _G.BB_HP_CANDS=hlist
      print('[BB] HP relocated 0x'..string.format('%x',hcand)..' candidates='..tostring(#hlist)) end
  end
  return true
end
local obj=getAddressSafe('bb_obj')
if obj==nil then if not ensureSyms() then print('[BB] pointer check failed') return end obj=getAddressSafe('bb_obj') end
if _G.BB_HP then _G.BB_HP() end
local cands=_G.BB_HP_CANDS
if cands==nil or #cands==0 then print('[BB] no candidates - tick [31] relocate first') end
local warned=false
local pid=getOpenedProcessID() local fails=0
local t=createTimer(nil,false) t.Interval=120
t.OnTimer=function(x)
 if getOpenedProcessID()~=pid then pcall(function() x.destroy() end) return end
 local mc=readInteger(obj+0x154) local mm=readInteger(obj+0x158)
 if mc==nil or mm==nil then fails=fails+1 if fails&gt;8 then pcall(function() x.destroy() end) end return end
 if mc&gt;=mm then warned=false return end
 if cands==nil or #cands==0 then return end
 local seen=0
 for _,c in ipairs(cands) do if readInteger(c)==mc then seen=seen+1 end end
 if seen==0 then
   if not warned then warned=true print('[BB] HP moved - tick [31] to relocate') end
   return
 end
 for _,c in ipairs(cands) do if readInteger(c)==mc then pcall(writeInteger,c,mm) end end
end
t.Enabled=true
_G.BB_HP=function() pcall(function() t.destroy() end) t=nil _G.BB_HP=nil end
print('[BB] keep HP full ON')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.BB_HP then _G.BB_HP() end
print('[BB] keep HP full OFF')
{$asm}
</AssemblerScript>
