    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"【血源诅咒 PC】YC 修改表 v0.9 ｜ bbport 移植版 ｜ CE 7.5+"</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"① 用法：CE 打开进程 → 选 bb-probe.exe → 勾 [0] → 再勾需要的功能"</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>3</ID>
      <Description>"② 启动（每次进游戏都要勾一次）"</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>4</ID>
      <Description>"===================================================="</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>5</ID>
      <Description>"[0] 启动脚本 ← 先勾这个（日志出现 READY 才算成功）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function locateHP(base,maxTry)
  local cur=readInteger(base+0x154) local mx=readInteger(base+0x158)
  if cur==nil or mx==nil or mx&lt;=0 or cur&lt;1 or cur&gt;mx then return nil,nil,nil end
  local function le(v) local b1=v%256 v=math.floor(v/256) local b2=v%256 v=math.floor(v/256) local b3=v%256 v=math.floor(v/256) local b4=v%256 return string.format('%02X %02X %02X %02X',b1,b2,b3,b4) end
  local res=AOBScan(le(cur)..' '..le(mx),'+W-C')
  if not res then return nil,nil end
  local cands={}
  for i=0,math.min(res.Count-1,300) do
    local a=tonumber(res.getString(i),16)
    if a and readInteger(a)==cur and readInteger(a+4)==mx then
      local inobj=(a&gt;=base and a&lt;base+0x6000)
      local instatic=(a&gt;=0x8050DC000 and a&lt;0x8056D30F4)
      if not inobj and not instatic then cands[#cands+1]=a end
    end
  end
  res.destroy()
  if #cands==0 then return nil,nil,nil end
  local probe=mx
  local tried=0 local lim=maxTry or 12
  for _,c in ipairs(cands) do
    if tried&gt;=lim then break end
    tried=tried+1
    local v0=readInteger(c)
    writeInteger(c,probe) sleep(45)
    local mc=readInteger(base+0x154)
    if mc==probe then writeInteger(c,mx) return c,mx,cands end
    writeInteger(c,v0)
  end
  return nil,nil,nil
end
local function ensureSyms()
  if getAddressSafe('bb_obj') then return true end
  local ok,base=pcall(readPointer,0x80553B0E0)
  if not ok or not base or base&lt;0x1000000000 or base&gt;=0x2000000000 then return false end
  registerSymbol('bb_obj',base,true)
  local ok1,v=pcall(readInteger,base+0x8B8) if ok1 and v then registerSymbol('bb_bullets',base+0x8B8,true) end
  local ok2,v2=pcall(readInteger,base+0x8E8) if ok2 and v2 then registerSymbol('bb_vials',base+0x8E8,true) end
  local ok3,v3=pcall(readInteger,base+0x1D4) if ok3 and v3 then registerSymbol('bb_echoes',base+0x1D4,true) end
  local ok4,c=pcall(readInteger,base+0x154) local ok5,m=pcall(readInteger,base+0x158)
  local ok6,hc=pcall(readInteger,0x1001AD56008) local ok7,hm=pcall(readInteger,0x1001AD5600C)
  if ok4 and ok5 and ok6 and ok7 and c==hc and m==hm and m and m&gt;0 then
    registerSymbol('bb_hp',0x1001AD56008,true) registerSymbol('bb_hpmax',0x1001AD5600C,true)
  else
    local hcand,hm2,hlist=locateHP(base)
    if hcand then registerSymbol('bb_hp',hcand,true) registerSymbol('bb_hpmax',hcand+4,true)
      _G.BB_HP_CANDS=hlist
      print('[BB] HP relocated 0x'..string.format('%x',hcand)..' candidates='..tostring(#hlist)) end
  end
  return true
end

local pid=getOpenedProcessID()
if pid==0 then print('[BB] attach bb-probe.exe first') return end
local ok,base=pcall(readPointer,0x80553B0E0)
if not ok or not base or base&lt;0x1000000000 or base&gt;=0x2000000000 then print('[BB] pointer check failed - wrong game build?') return end
local function findItem(id,fb)
  for off=0,0x2000,4 do
    local ok2,v=pcall(readInteger,base+off)
    if ok2 and v==id then return base+off+4,off+4 end
  end
  if fb then return base+fb,fb end
  return nil
end
local bul,boff=findItem(0x40000384,0x8B8)
local via,voff=findItem(0x400003E8,0x8E8)
if not bul then print('[BB] item table not found') return end
registerSymbol('bb_obj',base,true)
registerSymbol('bb_bullets',bul,true)
if via then registerSymbol('bb_vials',via,true) end
local ech=base+0x1D4
local ev=readInteger(ech)
if ev==nil or ev&lt;0 or ev&gt;999999999 then print('[BB] echoes field looks wrong: '..tostring(ev)) else registerSymbol('bb_echoes',ech,true) end
local function reg(n,a,lo,hi)
  local v=readInteger(a)
  if v==nil or v&lt;lo or v&gt;hi then print('[BB] '..n..' looks wrong: '..tostring(v)) return false end
  registerSymbol(n,a,true) return true
end
reg('bb_level',base+0x1D0,1,600)
reg('bb_vit',base+0x180,1,99)
reg('bb_end',base+0x188,1,99)
reg('bb_str',base+0x198,1,99)
reg('bb_skill',base+0x1A0,1,99)
reg('bb_blood',base+0x1A8,1,99)
reg('bb_arc',base+0x1B0,1,99)
local HP_ADDR=0x1001AD56008
local hcur,hmax=readInteger(HP_ADDR),readInteger(HP_ADDR+4)
local mcur,mmax=readInteger(base+0x154),readInteger(base+0x158)
if hcur~=nil and hmax~=nil and hcur==mcur and hmax==mmax and mmax&gt;0 and hcur&lt;=hmax then
  registerSymbol('bb_hp',HP_ADDR,true)
  registerSymbol('bb_hpmax',HP_ADDR+4,true)
  print('[BB] HP OK '..tostring(hcur)..'/'..tostring(hmax))
else
  local hcand,hm2,hlist=locateHP(base)
  if hcand then
    registerSymbol('bb_hp',hcand,true) registerSymbol('bb_hpmax',hcand+4,true)
    _G.BB_HP_CANDS=hlist
    print('[BB] HP relocated 0x'..string.format('%x',hcand)..' candidates='..tostring(#hlist))
  else
    print('[BB] HP locate failed: hp='..tostring(hcur)..' mirror='..tostring(mcur)..'/'..tostring(mmax))
  end
end

print('[BB] READY  obj=0x'..string.format('%x',base)..'  bullets='..tostring(readInteger(bul))..'  vials='..(via and tostring(readInteger(via)) or 'none')..'  echoes='..tostring(readInteger(base+0x1D4)))
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.BB_LB then _G.BB_LB() end
if _G.BB_LV then _G.BB_LV() end
unregisterSymbol('bb_bullets')
unregisterSymbol('bb_vials')
unregisterSymbol('bb_obj')
print('[BB] stopped')
{$asm}
</AssemblerScript>
