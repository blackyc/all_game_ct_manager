<CheatEntry>
      <ID>14</ID>
      <Description>"[8] 无限体力（真实字段 0x3C，有界扫描定位·换图自愈）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Bloodborne bbport v1.6.2 - infinite stamina (t9: map-change resilient)
-- Field facts (t5 real-input forensics, re-verified in t6/t8):
--   real attack gauge = driver+0x3C (cur) / driver+0x40 (max, 110)
--                       mirrored to obj+0x170 (cur) / obj+0x174 (max)
--   driver+0x30/+0x34/+0x38 and obj+0x160/+0x164 (131) are an unrelated gauge.
-- What t8 found: on a map load the *driver block* is freed and re-created at a new address
-- while obj (0x80553B0E0 slot) stays the same. A freed block can still read plausible values,
-- so a naive "does the pair still match" check never fires and every write lands on dead memory.
-- Fixes in this build:
--   1) locate by exact-qword scan of (hp_cur, hp_max) in bounded windows; AOBScan was measured
--      at 3.30s here (105 candidates) which blows the 1.5s budget, so it is NOT used
--   2) read-only cross validation (hp pair + stamina pair vs obj mirrors), unique -&gt; use it
--   3) re-resolve the static obj slot every tick; compare driver against the LIVE mirrors every
--      tick; 2 inconsistent ticks -&gt; drop the driver immediately (no 600ms wait, no 10s backoff)
--   4) effectiveness is judged by an independent window: every tick the live mirror stays
--      below the max counts (&gt;=6 ticks AND &gt;=150ms AND writes happened) -&gt; the driver is
--      unusable and is dropped; a healthy restore shows in the mirror within 1~2 frames.
--      Worst case after judging dead: the next locate may wait for the retry gap (&lt;=1s)
--      plus 0.06~0.28s of scan, i.e. a &lt;=~1s window with zero writes.
--   4b) hold (attack) is evidence-backed by sampling artifacts; a real map change is
--      verified manually by YC (no artifact yet) - see tmp/t11_report.md
--   5) ONE write point: driver+0x3C := driver+0x40, max re-read right before the write
--   6) total locate budget 1.5s, never a whole-address-space scan, no probe writes
local HP_PTR     = 0x80553B0E0
local CUR_OFF    = 0x3C
local MAX_OFF    = 0x40
local TICK_MS    = 12
local MAX_STAM   = 100000
local LOCAL_HALF = 0x02000000

local BUDGET_MS  = 1500
local RETRY_MS   = 1000   -- F4: first retry after a failed locate
local RETRY_MAX  = 3000   -- F4: cap for consecutive failures (1s -&gt; 3s)
local LAG_TOL    = 2
local BAD_TICKS  = 2
-- F5: independent write-effectiveness window (grace is gone: it was the blind spot)
local NO_EFFECT_WRITES = 6     -- consecutive writes while the mirror stays drained
local NO_EFFECT_MS     = 150   -- ...and at least this long (legit lag is 1~2 frames = 12~32ms)
local DEGRADED_TICKS   = 25    -- mirror unreadable this many ticks (300ms) -&gt; re-locate

local function rd(a)
  local ok, v = pcall(readInteger, a)
  if ok then return v end
  return nil
end

local function rp(a)
  local ok, v = pcall(readPointer, a)
  if ok then return v end
  return nil
end

local function nowms()
  local ok, v = pcall(getTickCount)
  if ok and v then return v end
  return os.time() * 1000
end

local pid = getOpenedProcessID()

local function getObj()
  local b = rp(HP_PTR)
  if not b or b &lt; 0x1000000000 or b &gt;= 0x2000000000 then return nil end
  return b
end

-- strict read-only validation, used when a candidate address is proposed
local function checkFull(d, obj)
  if d == nil or obj == nil then return false, 'no candidate/obj' end
  local d0 = rd(d)
  local d4 = rd(d + 4)
  local o0 = rd(obj + 0x154)
  local o4 = rd(obj + 0x158)
  if d0 == nil or d4 == nil or o0 == nil or o4 == nil then return false, 'hp read failed' end
  if d0 ~= o0 or d4 ~= o4 then return false, 'hp pair mismatch' end
  local dc = rd(d + CUR_OFF)
  local dm = rd(d + MAX_OFF)
  local oc = rd(obj + 0x170)
  local om = rd(obj + 0x174)
  if dc == nil or dm == nil then return false, 'stamina read failed' end
  if dm &lt;= 0 or dm &gt; MAX_STAM then return false, 'stamina max out of range' end
  if om ~= nil and om ~= dm then return false, 'stamina max mirror mismatch' end
  if dc &lt; 0 or dc &gt; dm then return false, 'stamina cur out of range' end
  if oc ~= nil and math.abs(oc - dc) &gt; LAG_TOL then return false, 'stamina cur mirror mismatch' end
  return true
end

-- per-tick consistency. Only the STABLE fields decide staleness: a freed/reused block shows
-- garbage in the hp pair or in the stamina max. The stamina CUR legitimately lags the mirror
-- for a frame or two while the game drains, so it never triggers a relocation by itself
-- (that would relocate on every attack burst).
local function checkLive(d, obj)
  local d0 = rd(d)
  local d4 = rd(d + 4)
  local o0 = rd(obj + 0x154)
  local o4 = rd(obj + 0x158)
  if d0 == nil or d4 == nil or o0 == nil or o4 == nil then return false, 'read failed' end
  -- F6: hp CUR legitimately changes when the player takes damage (and the mirror lags a
  -- frame), so it must never decide staleness - only the STABLE hp MAX does. hp cur is
  -- still compared strictly at locate time (checkFull).
  if d4 ~= o4 then return false, 'hp max drifted' end
  local dm = rd(d + MAX_OFF)
  local om = rd(obj + 0x174)
  if dm == nil then return false, 'stamina max unreadable' end
  if dm &lt;= 0 or dm &gt; MAX_STAM then return false, 'stamina max out of range' end
  if om ~= nil and om ~= dm then return false, 'stamina max drifted' end
  return true, dm, rd(d + CUR_OFF), rd(obj + 0x170)
end

local function le(v)
  local b1 = v % 256 v = math.floor(v / 256)
  local b2 = v % 256 v = math.floor(v / 256)
  local b3 = v % 256 v = math.floor(v / 256)
  local b4 = v % 256
  return string.format('%02X %02X %02X %02X', b1, b2, b3, b4)
end

-- exact-qword memscan over one bounded window (never the whole address space)
local function scanRange(q, lo, hi, obj)
  local ok, hits = pcall(function()
    local ms = createMemScan()
    ms.firstScan(soExactValue, vtQword, rtRounded, string.format('%d', q), nil,
                 lo, hi, '+W-C', fsmAligned, '8', false, false, false, false)
    ms.waitTillDone()
    local fl = createFoundList(ms)
    fl.initialize()
    local out = {}
    for i = 0, fl.getCount() - 1 do
      local a = tonumber(fl.getAddress(i), 16)
      if a and not (a &gt;= obj and a &lt; obj + 0x2000) then out[#out + 1] = a end
    end
    fl.destroy()
    ms.destroy()
    return out
  end)
  if not ok then return nil end
  return hits
end

local function pickValid(list, obj, tag)
  local passes = {}
  for _, a in ipairs(list) do
    -- hard guard: the driver base is 8-aligned; a +4 shifted hit would turn our single write
    -- point into base+0x40 (the max field) - the most dangerous possible mis-write.
    if a % 8 == 0 and checkFull(a, obj) then passes[#passes + 1] = a end
  end
  if #passes == 0 then return nil end
  local best = passes[1]
  for i = 2, #passes do
    if passes[i] &lt; best then best = passes[i] end
  end
  if #passes &gt; 1 then
    print('[BB] stamina WARN ' .. tostring(tag) .. ' pass=' .. #passes .. ' -&gt; lowest 0x' .. string.format('%x', best))
  end
  return best, #passes
end

local function locate()
  local t0 = nowms()
  local obj = getObj()
  if not obj then return nil, 'no object pointer' end

  -- 1) cached driver (validated read-only)
  local cached = _G.BB_ST_DRV
  if cached and checkFull(cached, obj) then return cached, 'cache' end

  -- 2) bb_hp registered by [0] (often wrong; validated before use)
  local sym = getAddressSafe('bb_hp')
  if sym and checkFull(sym, obj) then return sym, 'bb_hp' end

  local hp = rd(obj + 0x154)
  local hpmx = rd(obj + 0x158)
  if hp == nil or hpmx == nil or hpmx &lt;= 0 or hp &lt; 1 or hp &gt; hpmx then
    return nil, 'hp mirror invalid'
  end

  local q = hp + hpmx * 4294967296

  -- 3) fast path: a small window around the last driver we ever saw (heap blocks of this
  --    size class are usually re-created nearby; measured ~30-60ms for +-32MB)
  local last = _G.BB_ST_LAST
  if last then
    local hits = scanRange(q, last - LOCAL_HALF, last + LOCAL_HALF, obj)
    if hits and #hits &gt; 0 then
      local best = pickValid(hits, obj, 'local')
      if best then return best, 'local' end
    end
  end

  if nowms() - t0 &gt; BUDGET_MS then return nil, 'budget exceeded' end

  -- 4) bounded windows around obj (same tiers as before; never the whole address space)
  local tiers = { 0x20000000, 0x80000000 }
  for _, half in ipairs(tiers) do
    local hits = scanRange(q, obj - half, obj + half, obj)
    if hits and #hits &gt; 0 then
      local best, n = pickValid(hits, obj, 'scan' .. string.format('%x', half))
      if best then return best, 'scan' .. string.format('%x', half) end
    end
    if nowms() - t0 &gt; BUDGET_MS then return nil, 'budget exceeded' end
  end
  return nil, 'no cross-validated candidate'
end

_G.BB_ST_LOCATE = locate
local driver, drvObj, bad, writes, lastTry, failCount, writeStreak, streakStart
local streakWrites, streakBad, retryGap
driver = nil drvObj = nil bad = 0 writes = 0 lastTry = 0 failCount = 0
writeStreak = 0 streakStart = nil streakWrites = 0 streakBad = 0 retryGap = RETRY_MS

local function announce(d, why)
  driver = d
  drvObj = getObj()
  bad = 0
  failCount = 0
  retryGap = RETRY_MS
  writeStreak = 0
  streakStart = nil
  streakWrites = 0
  streakBad = 0
  _G.BB_ST_DRV = d
  _G.BB_ST_LAST = d
  print('[BB] stamina driver 0x' .. string.format('%x', d) .. ' via ' .. tostring(why)
    .. '  stam=' .. tostring(rd(d + CUR_OFF)) .. '/' .. tostring(rd(d + MAX_OFF))
    .. ' obj=0x' .. string.format('%x', drvObj or 0))
end

local function tryLocate()
  lastTry = nowms()
  local d, why = locate()
  if d then announce(d, why) return true end
  driver = nil
  _G.BB_ST_DRV = nil
  failCount = failCount + 1
  if failCount &gt;= 2 then retryGap = RETRY_MAX else retryGap = RETRY_MS end
  print('[BB] stamina NOT locked (' .. tostring(why) .. ') - zero write, retry #' .. tostring(failCount)
    .. ' in ' .. tostring(math.floor(retryGap / 1000)) .. 's')
  return false
end

if _G.BB_ST then _G.BB_ST() end
tryLocate()

local t = createTimer(nil, false)
t.Interval = TICK_MS
t.OnTimer = function(x)
  if getOpenedProcessID() ~= pid then
    pcall(function() x.destroy() end)
    _G.BB_ST_T = nil
    return
  end
  local o = getObj()
  if o == nil then
    if driver ~= nil then
      print('[BB] stamina object unreadable - drop driver (zero write)')
      driver = nil _G.BB_ST_DRV = nil bad = 0
    end
    return
  end
  if driver ~= nil and o ~= drvObj then
    print('[BB] stamina object moved - drop driver (zero write)')
    driver = nil _G.BB_ST_DRV = nil bad = 0
  end
  if driver ~= nil then
    local okLive, dm, dc, oc = checkLive(driver, o)
    if okLive then
      bad = 0
      if dc ~= nil and dm ~= nil and dc &gt;= 0 and dc &lt; dm then
        local dm2 = rd(driver + MAX_OFF)
        if dm2 == dm then
          -- the ONLY write in this script
          local okW = pcall(writeInteger, driver + CUR_OFF, dm)
          if okW then
            writes = writes + 1
            streakWrites = streakWrites + 1
          end
        end
      end
      -- F5: independent effectiveness window. The counter runs on EVERY tick the live mirror
      -- is below the max - NOT only on ticks that wrote. A dead block either stops being
      -- written the moment our write makes it say "full", or the game overwrites it every
      -- frame; in both shapes the mirror stays drained, so only a per-tick counter keeps
      -- climbing. A healthy restore shows in the mirror within 1~2 frames (12~32ms).
      if oc == nil then
        -- mirror unreadable: effectiveness cannot be judged. Count it so a permanently
        -- unreadable object still re-locates instead of freezing silently.
        streakBad = streakBad + 1
        if streakBad &gt;= DEGRADED_TICKS then
          print('[BB] stamina mirror unreadable (' .. tostring(streakBad) .. ' ticks) - re-locate (zero write)')
          driver = nil _G.BB_ST_DRV = nil bad = 0 writeStreak = 0 streakStart = nil
          streakWrites = 0 streakBad = 0
        end
      elseif dm ~= nil and dm &gt; 0 and oc &lt; dm then
        writeStreak = writeStreak + 1
        if streakStart == nil then streakStart = nowms() end
        if writeStreak &gt;= NO_EFFECT_WRITES and (nowms() - streakStart) &gt;= NO_EFFECT_MS then
          print('[BB] stamina mirror stays drained (' .. tostring(writeStreak) .. ' ticks / ' ..
            tostring(nowms() - streakStart) .. 'ms, writes ' .. tostring(streakWrites) ..
            ', mirror ' .. tostring(oc) .. '&lt;' .. tostring(dm) ..
            ') - driver unusable, re-locate (zero write)')
          driver = nil _G.BB_ST_DRV = nil bad = 0 writeStreak = 0 streakStart = nil
          streakWrites = 0 streakBad = 0
        end
      else
        writeStreak = 0 streakStart = nil streakWrites = 0 streakBad = 0
      end
    else
      bad = bad + 1
      if bad &gt;= BAD_TICKS then
        local _, why = checkLive(driver, o)
        print('[BB] stamina driver inconsistent (' .. tostring(why) .. ') - immediate re-locate (zero write)')
        driver = nil _G.BB_ST_DRV = nil bad = 0 writeStreak = 0 streakStart = nil
        streakWrites = 0 streakBad = 0
      end
    end
  end
  if driver == nil then
    if nowms() - lastTry &gt;= retryGap then tryLocate() end
  end
end
t.Enabled = true
_G.BB_ST_T = t
_G.BB_ST_WRITES = function() return writes end
_G.BB_ST = function()
  pcall(function()
    if _G.BB_ST_T then
      _G.BB_ST_T.Enabled = false
      _G.BB_ST_T.destroy()
    end
  end)
  _G.BB_ST_T = nil
  _G.BB_ST_DRV = nil
end
print('[BB] infinite stamina ON (bounded locate, per-tick driver tracking, single write point)')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.BB_ST then _G.BB_ST() end
print('[BB] infinite stamina OFF')
{$asm}
</AssemblerScript>
    </CheatEntry>
<CheatEntry>
      <ID>15</ID>
      <Description>"潜行 ← 敌人无视你，不主动攻击（0x80553E88E = 1）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
writeBytes(0x80553E88E, 1)
{$asm}
