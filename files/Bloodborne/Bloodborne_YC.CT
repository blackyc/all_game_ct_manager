      <CheatEntry>
      <ID>9001</ID>
      <Description>"[99] 诊断 ← 功能不生效时勾一下，把日志发给作者"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local CEV = "?"
pcall(function() CEV = tostring(getCEVersion()) end)
local out = {}
out[#out + 1] = "==== BB DIAG ===="
out[#out + 1] = "CE=" .. CEV .. "  Lua=" .. tostring(_VERSION)
local ok, obj = pcall(readPointer, 0x80553B0E0)
if not ok or not obj then
  out[#out + 1] = "obj pointer slot 0x80553B0E0 UNREADABLE -&gt; wrong process or wrong build"
  print(table.concat(out, "\n"))
  if _G.bb_diagTimer then pcall(function() _G.bb_diagTimer.Enabled=false _G.bb_diagTimer.destroy() end) _G.bb_diagTimer=nil end
  return
end
out[#out + 1] = string.format("obj=0x%x", obj)
local hpm, hpc = readInteger(obj + 0x158), readInteger(obj + 0x154)
out[#out + 1] = string.format("hp=%s/%s  echoes=%s  level=%s",
  tostring(hpc), tostring(hpm), tostring(readInteger(obj + 0x1D4)), tostring(readInteger(obj + 0x1D0)))
local function u32(v) if v == nil then return nil end if v &lt; 0 then return v + 4294967296 end return v end
local function lo16(v) return math.floor(v) % 65536 end
local function hi16(v) return math.floor(v / 65536) % 65536 end
local b0, n, other = nil, 0, 0
for r = 0, 63 do
  local off = 0x8A0 + r * 0x10
  local lo = u32(readInteger(obj + off))
  if lo == nil then break end
  if lo &gt;= 0xB0000000 and lo &lt; 0xB0010000 then
    if b0 == nil then b0 = off end
    n = n + 1
    local hi = u32(readInteger(obj + off + 4))
    local c = readInteger(obj + off + 8)
    if r &lt; 8 or lo16(lo) == 900 or lo16(lo) == 1000 or (lo &gt;= 0xB0000B54 and lo &lt;= 0xB0000D02) then
      out[#out + 1] = string.format("  r%02d off=0x%x id=0x%08x num=%d cnt=%s hi=0x%08x",
        r, off, lo, lo16(lo), tostring(c), hi or 0)
    end
  elseif lo ~= 0 then
    other = other + 1
  end
end
out[#out + 1] = string.format("item table @0x8A0: %d item rows, %d non-item rows, first B0 row=%s",
  n, other, b0 and string.format("0x%x", b0) or "NONE")
if b0 == nil then
  out[#out + 1] = "  !! no 0xB0xxxxxx row inside 0x8A0..0xCA0 - table has MOVED in this build"
  local found = 0
  for off = 0x100, 0x4000, 4 do
    local lo = u32(readInteger(obj + off))
    if lo and lo &gt;= 0xB0000000 and lo &lt; 0xB0010000 then
      local hi = u32(readInteger(obj + off + 4))
      if hi and hi16(hi) == 0x4000 then
        found = found + 1
        if found &lt;= 10 then out[#out + 1] = string.format("    candidate off=0x%x id=0x%08x cnt=%s",
          off, lo, tostring(readInteger(obj + off + 8))) end
      end
    end
  end
  out[#out + 1] = "  scan candidates=" .. found
end
print(table.concat(out, "\n"))
-- keep it one-shot; the entry stays ticked but does nothing more
if _G.bb_diagTimer then pcall(function() _G.bb_diagTimer.Enabled=false _G.bb_diagTimer.destroy() end) _G.bb_diagTimer=nil end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.bb_diagTimer then pcall(function() _G.bb_diagTimer.Enabled=false _G.bb_diagTimer.destroy() end) _G.bb_diagTimer=nil end
{$asm}</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>