if _G.bb_stoneLock ~= nil then pcall(function() _G.bb_stoneLock.Enabled=false _G.bb_stoneLock.destroy() end) _G.bb_stoneLock = nil end
local LO, HI, TARGET = 0xB0000B54, 0xB0000D02, 99
local rows, lastObj, tick = nil, nil, 0
local seen = {}
local function scanTable(obj)
  local out = {}
  for r = 0, TBL_ROWS - 1 do
    local off = TBL_BASE + r * TBL_STRIDE
    local lo = u32(readInteger(obj + off))
    if not lo then return nil end
    if lo == 0 then
      -- keep going: an empty row in the middle is normal
    elseif not rowOk(obj, off, nil) then
      -- non-item record (0x808000xx / 0x908000xx / 0xC08000xx ...)
    else
      if lo &gt;= LO and lo &lt;= HI then
        local c = readInteger(obj + off + 8)
        if c and c &gt;= 1 then seen[lo] = true end
        out[#out + 1] = { off = off, id = lo }
      end
    end
  end
  return out
end
local function scanAny(obj)
  local out = {}
  for off = 0x100, 0x4000, 4 do
    local lo = u32(readInteger(obj + off))
    if lo and lo &gt;= LO and lo &lt;= HI then
      if rowOk(obj, off, nil) then
        local c = readInteger(obj + off + 8)
        if c and c &gt;= 1 then seen[lo] = true end
        out[#out + 1] = { off = off, id = lo }
      end
    end
  end
  return out
end
local t = createTimer(nil, false)
t.Interval = 100
t.OnTimer = function()
  pcall(function()
    local obj = getObj()
    if not obj then return end
    local mx, cur = readInteger(obj + 0x158), readInteger(obj + 0x154)
    if not mx or not cur or mx &lt; 10 or mx &gt; 5000 or cur &lt; 0 or cur &gt; mx then return end
    tick = tick + 1
    if rows == nil or obj ~= lastObj or tick % 10 == 0 then
      lastObj = obj
      rows = scanTable(obj)
      -- a base offset that lands mid-table returns a PARTIAL table without erroring,
      -- so treat "suspiciously few rows" as broken too, not just zero
      if rows == nil or #rows &lt; 8 then
        local alt = scanAny(obj)
        if alt and #alt &gt; #(rows or {}) then
          print("[BB] stones: table partial/moved at 0x8A0, " .. #alt .. " rows via scan")
          rows = alt
        end
      end
    end
    for i = 1, #rows do
      local e = rows[i]
      local lo = u32(readInteger(obj + e.off))
      if lo == e.id then
        local a = obj + e.off + 8
        local c = readInteger(a)
        if c and c &gt;= 0 and c &lt; TARGET and (c &gt;= 1 or seen[e.id]) then
          writeInteger(a, TARGET)
        end
      end
    end
  end)
end
t.Enabled = true          -- MANDATORY
_G.bb_stoneLock = t
print("[BB] stone lock ON (" .. tostring(rows and #rows or 0) .. " rows, CE " .. CEV .. ")")
{$asm}
