<CheatEntry>
      <ID>9</ID>
      <Description>"[4] 无限水银弹（锁定当前上限）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- CE/Lua env note: bitwise operators need Lua 5.3; older CE builds raise a syntax
-- error on `&amp;` and kill the whole chunk, so use arithmetic instead.
local CEV = "?"
pcall(function() CEV = tostring(getCEVersion()) end)
local TBL_BASE, TBL_STRIDE, TBL_ROWS = 0x8A0, 0x10, 64
local function u32(v)
  if v == nil then return nil end
  if v &lt; 0 then return v + 4294967296 end
  return v
end
local function lo16(v) return math.floor(v) % 65536 end
local function hi16(v) return math.floor(v / 65536) % 65536 end
local function rowOk(obj, off, wantNum)
  local lo = u32(readInteger(obj + off))
  if not lo or lo &lt; 0xB0000000 or lo &gt;= 0xB0010000 then return false end
  if wantNum and lo16(lo) ~= wantNum then return false end
  local hi = u32(readInteger(obj + off + 4))
  if not hi or hi16(hi) ~= 0x4000 then return false end
  if wantNum and lo16(hi) ~= wantNum then return false end
  local c = readInteger(obj + off + 8)
  if not c or c &lt; 0 or c &gt; 9999 then return false end
  return true
end
-- table first (fast, known layout), then a signature sweep of the whole object
-- (covers bbport builds that moved the item table)
local function findRow(obj, num)
  for r = 0, TBL_ROWS - 1 do
    local off = TBL_BASE + r * TBL_STRIDE
    if rowOk(obj, off, num) then return off, "table" end
  end
  for off = 0x100, 0x4000, 4 do
    if rowOk(obj, off, num) then return off, "scan" end
  end
  return nil, "notfound"
end
local function getObj()
  local ok, o = pcall(readPointer, 0x80553B0E0)
  if not ok or not o then return nil end
  if o &lt; 0x1000000000 or o &gt;= 0x800000000000 then return nil end
  return o
end
if _G.bb_bulletLock ~= nil then pcall(function() _G.bb_bulletLock.Enabled=false _G.bb_bulletLock.destroy() end) _G.bb_bulletLock = nil end
local NUM = 900
local DEFAULT_CAP = 20
local CAP = nil
local CAP_OBJ = nil
local ROW = nil
local function snapshot(c)
  if CAP == nil then
    if c &gt; DEFAULT_CAP then CAP = c else CAP = DEFAULT_CAP end
    print("[BB] bullets cap=" .. tostring(CAP))
  end
end
local t = createTimer(nil, false)
t.Interval = 30
t.OnTimer = function()
  pcall(function()
    local obj = getObj()
    if not obj then return end
    local mx, cur = readInteger(obj + 0x158), readInteger(obj + 0x154)
    if not mx or not cur or mx &lt; 10 or mx &gt; 5000 or cur &lt; 0 or cur &gt; mx then return end
    if CAP_OBJ ~= obj then
      -- 换角色/读档：旧上限快照必须作废，否则会把新角色少量库存补成上一个角色的数量
      CAP, CAP_OBJ, ROW = nil, obj, nil
    end
    if CAP_OBJ ~= obj then
      -- 换角色/读档：旧上限快照必须作废，否则会把新角色少量库存补成上一个角色的数量
      CAP, CAP_OBJ, ROW = nil, obj, nil
    end
    if ROW == nil or not rowOk(obj, ROW, NUM) then
      ROW = findRow(obj, NUM)
      if ROW == nil then return end
      print("[BB] bullets row 0x" .. string.format("%x", ROW))
    end
    local c = readInteger(obj + ROW + 8)
    if not c or c &lt; 0 or c &gt; 9999 then return end
    snapshot(c)
    if c &lt; CAP then writeInteger(obj + ROW + 8, CAP) end
  end)
end
t.Enabled = true          -- MANDATORY: a bare createTimer() comes up disabled on some CE builds
_G.bb_bulletLock = t
print("[BB] infinite bullets ON (CE " .. CEV .. ")")
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.bb_bulletLock ~= nil then pcall(function() _G.bb_bulletLock.Enabled=false _G.bb_bulletLock.destroy() end) _G.bb_bulletLock = nil end
print("[BB] infinite bullets OFF")
{$asm}</AssemblerScript>
