<CheatEntry>
      <ID>5</ID>
      <Description>"不死模式 ← 血量永不低于 1（社区补丁 Player No Dead，每秒重申一次，定时器显式启用）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if _G.bb_noDead ~= nil then pcall(function() _G.bb_noDead.Enabled=false _G.bb_noDead.destroy() end) _G.bb_noDead = nil end
writeInteger(0x80553E888, 1)
local t = createTimer(nil, false)
t.Interval = 1000
t.OnTimer = function()
  pcall(function()
    if readInteger(0x80553E888) ~= 1 then writeInteger(0x80553E888, 1) end
  end)
end
t.Enabled = true          -- MANDATORY: without this the patch is applied once and lost on the next load
_G.bb_noDead = t
print("[BB] no-dead ON (re-assert 1Hz)")
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if _G.bb_noDead ~= nil then pcall(function() _G.bb_noDead.Enabled=false _G.bb_noDead.destroy() end) _G.bb_noDead = nil end
writeInteger(0x80553E888, 0)
print("[BB] no-dead OFF")
{$asm}</AssemblerScript>
