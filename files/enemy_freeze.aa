[ENABLE]
aobscanmodule(ECUPD,GameAssembly.dll,48 89 5C 24 10 57 48 81 EC 80 00 00 00 80 3D ?? ?? ?? ?? 00 48 8B D9 75 ?? 48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? C6 05 ?? ?? ?? ?? 01 48 8B 0D ?? ?? ?? ?? 48 8B 7B 38 83 B9 E0 00 00 00 00)
alloc(newmem2,$1000,ECUPD)
alloc(pEnemyController,8,ECUPD)
alloc(enemyKlass,8,ECUPD)
alloc(enemyFreeze,1,ECUPD)
alloc(enemyAnimSpeed,4,ECUPD)
registersymbol(pEnemyController)
registersymbol(enemyKlass)
registersymbol(enemyFreeze)
registersymbol(enemyAnimSpeed)
label(return2)
label(noAct)
label(skipAnim)
label(klassOk)

newmem2:
  mov [pEnemyController],rcx
  cmp qword ptr [enemyKlass],00
  jne klassOk
  mov rax,[rcx]
  mov [enemyKlass],rax
klassOk:
  cmp byte ptr [enemyFreeze],00
  je noAct
  mov byte ptr [rcx+000001C3],00
  push rax
  mov rax,[rcx+00000048]
  test rax,rax
  je skipAnim
  movss xmm0,[enemyAnimSpeed]
  movss [rax+00000048],xmm0
  mov dword ptr [rax+0000005C],0
  mov dword ptr [rax+00000060],0
  mov dword ptr [rax+00000064],0
skipAnim:
  pop rax
noAct:
  mov [rsp+10],rbx
  push rdi
  sub rsp,80
  jmp return2

ECUPD:
  jmp newmem2
  nop 8
return2:
registersymbol(ECUPD)

pEnemyController:
  dq 0
enemyKlass:
  dq 0
enemyFreeze:
  db 01
enemyAnimSpeed:
  dd (float)0.0

[DISABLE]
ECUPD:
  db 48 89 5C 24 10 57 48 81 EC 80 00 00 00
{$lua}
if syntaxcheck then return end
local ka = getAddressSafe('enemyKlass')
local kl = (ka ~= nil) and readQword(ka) or 0
if kl ~= nil and kl ~= 0 then
  local bytes = {}
  local v = kl
  for i = 1, 8 do bytes[i] = string.format('%02X', v % 256); v = math.floor(v / 256) end
  local res = AOBScan(table.concat(bytes, ' '))
  if res then
    for i = 0, res.Count - 1 do
      local a = tonumber(res.getString(i) or '', 16)
      if a then
        local mx = readFloat(a + 0x114)
        local an = readQword(a + 0x48)
        if mx ~= nil and an ~= nil and mx > 0.5 and mx < 1000000 and an > 0x10000 then
          writeFloat(an + 0x48, 1.0)
          writeFloat(an + 0x5C, 1.0)
          writeFloat(an + 0x60, 1.0)
          writeBytes(a + 0x1C3, 1)
        end
      end
    end
    res.destroy()
  end
end
{$asm}
unregistersymbol(ECUPD)
unregistersymbol(pEnemyController)
unregistersymbol(enemyKlass)
unregistersymbol(enemyFreeze)
unregistersymbol(enemyAnimSpeed)
dealloc(newmem2)
dealloc(pEnemyController)
dealloc(enemyKlass)
dealloc(enemyFreeze)
dealloc(enemyAnimSpeed)
